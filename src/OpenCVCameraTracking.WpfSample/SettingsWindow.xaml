<Window x:Class="OpenCVCameraTracking.WpfSample.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="940" Height="680"
        MinWidth="820" MinHeight="600" WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#EAF0F4" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource StreamProfiles}" Foreground="#8FA2AD" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#172128" CornerRadius="8" Padding="12,7">
                <TextBlock Text="OpenCV · WPF" Foreground="#72D6B5" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#182127" BorderBrush="#2C3B44" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource StreamProfiles}" FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <ListBox x:Name="ProfilesBox" Grid.Row="1" DisplayMemberPath="Name"
                             SelectionChanged="ProfilesBox_OnSelectionChanged" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource ProfileName}" Margin="0,12,0,0" />
                    <TextBox x:Name="ProfileNameBox" Grid.Row="3" />
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{DynamicResource ProfileAddress}" />
                        <TextBox x:Name="ProfileAddressBox" />
                    </StackPanel>
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{DynamicResource AddOrUpdate}" Click="AddOrUpdateButton_OnClick"
                                Background="#087F5B" BorderBrush="#18A979" Margin="0,3,5,3" />
                        <Button Grid.Column="1" Content="{DynamicResource Delete}" Click="DeleteButton_OnClick"
                                Margin="5,3,0,3" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#182127" BorderBrush="#2C3B44" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource GeneralSettings}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Language}" Margin="0,12,0,0" />
                        <ComboBox x:Name="LanguageBox">
                            <ComboBoxItem Content="{DynamicResource Chinese}" Tag="zh-CN" />
                            <ComboBoxItem Content="{DynamicResource English}" Tag="en-US" />
                        </ComboBox>

                        <TextBlock Text="{DynamicResource DefaultStream}" />
                        <ComboBox x:Name="DefaultStreamBox" DisplayMemberPath="Name" />

                        <Separator Margin="0,5,0,15" Background="#34454F" />
                        <TextBlock Text="{DynamicResource RtspSettings}" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox x:Name="LowLatencyBox" Content="{DynamicResource LowLatencyMode}" Margin="0,12,0,3" />
                        <TextBlock Text="{DynamicResource LowLatencyHint}" TextWrapping="Wrap"
                                   Foreground="#8FA2AD" FontSize="12" Margin="22,0,0,12" />

                        <Separator Margin="0,5,0,15" Background="#34454F" />
                        <TextBlock Text="{DynamicResource DetectionSettings}" FontSize="18" FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource FaceConfidence}" />
                            <TextBlock x:Name="FaceConfidenceText" Grid.Column="1" Foreground="#72D6B5" />
                        </Grid>
                        <Slider x:Name="FaceConfidenceSlider" Minimum="0.3" Maximum="0.9" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_OnValueChanged" Margin="0,7,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AnimalConfidence}" />
                            <TextBlock x:Name="AnimalConfidenceText" Grid.Column="1" Foreground="#72D6B5" />
                        </Grid>
                        <Slider x:Name="AnimalConfidenceSlider" Minimum="0.15" Maximum="0.8" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_OnValueChanged" Margin="0,7,0,5" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#71838D" Text="settings.json · LocalAppData" />
            <Button Grid.Column="1" Content="{DynamicResource Cancel}" Click="CancelButton_OnClick" MinWidth="100" />
            <Button Grid.Column="2" Content="{DynamicResource Save}" Click="SaveButton_OnClick"
                    Background="#087F5B" BorderBrush="#18A979" MinWidth="110" />
        </Grid>
    </Grid>
</Window>
