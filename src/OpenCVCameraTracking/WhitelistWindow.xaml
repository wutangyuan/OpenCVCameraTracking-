<Window x:Class="OpenCVCameraTracking.WhitelistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WhitelistTitle}" Height="560" Width="680"
        MinHeight="500" MinWidth="600"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16" CornerRadius="9" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource EnrollCurrentTarget}" FontSize="19"
                           FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource WhitelistType}" />
                        <ComboBox x:Name="KindBox">
                            <ComboBoxItem Content="{DynamicResource WhitelistFace}" Tag="Face" IsSelected="True" />
                            <ComboBoxItem Content="{DynamicResource WhitelistCat}" Tag="Cat" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource WhitelistName}" />
                        <TextBox x:Name="NameBox" MaxLength="50" />
                    </StackPanel>
                </Grid>
                <Button Content="{DynamicResource CaptureEnroll}" Click="EnrollButton_OnClick"
                        HorizontalAlignment="Left" Background="{DynamicResource AccentFillBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="White" />
                <Button Content="{DynamicResource SelectRegionEnroll}" Click="SelectRegionButton_OnClick"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                <TextBlock Text="{DynamicResource WhitelistEnrollHint}" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" Margin="4,8,4,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{DynamicResource WhitelistMembers}" FontSize="19"
                   FontWeight="SemiBold" Margin="0,16,0,8" />

        <ListBox x:Name="ProfileList" Grid.Row="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SampleText}" Foreground="{DynamicResource AccentHighlightBrush}"
                                   VerticalAlignment="Center" Margin="12,0,4,0" />
                        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Samples}" Margin="0,38,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4,6,4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}" Width="64" Height="64" Stretch="UniformToFill"
                                               MouseLeftButtonDown="Sample_OnMouseLeftButtonDown" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Content="{DynamicResource DeleteSelected}" Click="DeleteButton_OnClick"
                    Background="{DynamicResource DangerButtonBrush}" BorderBrush="{DynamicResource DangerButtonBorderBrush}" />
            <TextBlock x:Name="StoragePathText" Grid.Column="1" Foreground="{DynamicResource SubtleTextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />
            <Button Grid.Column="2" Content="{DynamicResource Close}" Click="CloseButton_OnClick" />
        </Grid>
    </Grid>
</Window>
