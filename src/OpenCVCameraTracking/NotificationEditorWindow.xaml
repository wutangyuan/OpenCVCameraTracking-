<Window x:Class="OpenCVCameraTracking.NotificationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NotificationEditorTitle}" Width="650" Height="720"
        MinWidth="560" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Icon="Assets/AppIcon.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource NotificationEditorTitle}" FontSize="22" FontWeight="SemiBold"
                   Margin="0,0,0,14" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource NotificationName}" />
                        <TextBox x:Name="NameBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource NotificationEnabled}" />
                        <CheckBox x:Name="EnabledBox" Content="{DynamicResource Enabled}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource NotificationType}" Margin="0,14,0,0" />
                <ComboBox x:Name="ChannelTypeBox" SelectionChanged="ChannelTypeBox_OnSelectionChanged">
                    <ComboBoxItem Content="{DynamicResource NotificationTypeServerChan}" Tag="ServerChan" />
                    <ComboBoxItem Content="{DynamicResource NotificationTypeFeishu}" Tag="Feishu" />
                    <ComboBoxItem Content="{DynamicResource NotificationTypeEmail}" Tag="Email" />
                    <ComboBoxItem Content="{DynamicResource NotificationTypeTelegram}" Tag="Telegram" />
                </ComboBox>

                <StackPanel x:Name="ServerChanPanel" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource ServerChanSendKey}" />
                    <TextBox x:Name="ServerChanSendKeyBox" />
                    <TextBlock Text="{DynamicResource ServerChanSendKeyHint}" Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel x:Name="FeishuPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource FeishuWebhookUrl}" />
                    <TextBox x:Name="FeishuWebhookUrlBox" />
                    <TextBlock Text="{DynamicResource FeishuSecret}" Margin="0,10,0,0" />
                    <TextBox x:Name="FeishuSecretBox" />
                    <TextBlock Text="{DynamicResource FeishuSecretHint}" Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel x:Name="EmailPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SmtpHost}" />
                            <TextBox x:Name="SmtpHostBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{DynamicResource SmtpPort}" />
                            <TextBox x:Name="SmtpPortBox" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="SmtpUseSslBox" Content="{DynamicResource SmtpUseSsl}" Margin="0,10,0,0" />
                    <TextBlock Text="{DynamicResource SmtpUsername}" Margin="0,10,0,0" />
                    <TextBox x:Name="SmtpUsernameBox" />
                    <TextBlock Text="{DynamicResource SmtpPassword}" Margin="0,10,0,0" />
                    <PasswordBox x:Name="SmtpPasswordBox" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MailFrom}" />
                            <TextBox x:Name="MailFromBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{DynamicResource MailTo}" />
                            <TextBox x:Name="MailToBox" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource MailHint}" Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel x:Name="TelegramPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource TelegramBotToken}" />
                    <TextBox x:Name="TelegramBotTokenBox" />
                    <TextBlock Text="{DynamicResource TelegramChatId}" Margin="0,10,0,0" />
                    <TextBox x:Name="TelegramChatIdBox" />
                    <TextBlock Text="{DynamicResource TelegramChatIdHint}" Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <Separator Margin="0,18,0,12" Background="{DynamicResource DividerBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource NotificationEventSelection}" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="{DynamicResource NotificationSelectAll}" Click="SelectAllNotificationEventsButton_OnClick"
                            Padding="8,2" />
                </Grid>
                <TextBlock Text="{DynamicResource NotificationEventSelectionHint}" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" FontSize="12" Margin="0,5,0,8" />
                <WrapPanel x:Name="NotificationEventsPanel" />
                <TextBlock x:Name="NotificationEventsSummaryText" Foreground="{DynamicResource AccentHighlightBrush}"
                           FontSize="12" Margin="0,7,0,0" />

                <TextBlock x:Name="TestStatusText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                           Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TestButton" Content="{DynamicResource TestNotification}" Click="TestButton_OnClick"
                    MinWidth="90" />
            <Button Grid.Column="2" Content="{DynamicResource Cancel}" Click="CancelButton_OnClick"
                    MinWidth="90" Margin="8,0,0,0" />
            <Button Grid.Column="3" Content="{DynamicResource Confirm}" Click="ConfirmButton_OnClick"
                    MinWidth="100" Margin="8,0,0,0" Background="{DynamicResource AccentFillBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="White" />
        </Grid>
    </Grid>
</Window>
