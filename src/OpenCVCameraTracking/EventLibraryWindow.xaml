<Window x:Class="OpenCVCameraTracking.EventLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EventLibraryTitle}" Height="720" Width="1120"
        MinHeight="560" MinWidth="880"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="EventItemTemplate">
            <Border Margin="3" Padding="7" CornerRadius="6"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="62" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource PreviewBackgroundBrush}">
                        <Image Source="{Binding SnapshotUri}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource EventLibraryTitle}" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource EventRetentionHelp}" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource EventRetention}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <ComboBox x:Name="RetentionBox" Width="112" SelectedValuePath="Tag"
                          SelectionChanged="RetentionBox_OnSelectionChanged">
                    <ComboBoxItem Content="{DynamicResource EventRetentionDays3}" Tag="3" />
                    <ComboBoxItem Content="{DynamicResource EventRetentionDays7}" Tag="7" />
                    <ComboBoxItem Content="{DynamicResource EventRetentionDays14}" Tag="14" />
                    <ComboBoxItem Content="{DynamicResource EventRetentionDays30}" Tag="30" />
                </ComboBox>
                <Button Content="{DynamicResource EventRefresh}" Click="RefreshButton_OnClick" Margin="7,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="300" />
                <ColumnDefinition Width="1.1*" MinWidth="400" />
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,7,0" Padding="5" CornerRadius="8"
                    Background="{DynamicResource SurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="EventListBox" ItemTemplate="{StaticResource EventItemTemplate}"
                             SelectionChanged="EventListBox_OnSelectionChanged" />
                    <TextBlock x:Name="EmptyEventsText" Text="{DynamicResource EventEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="20" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="7,0,0,0" Padding="13" CornerRadius="8"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="EventDetailsText" Text="{DynamicResource EventSelectPrompt}"
                               TextWrapping="Wrap" FontSize="14" />
                    <Image x:Name="SnapshotImage" Grid.Row="1" MaxHeight="190" Margin="0,12,0,8"
                           Stretch="Uniform" HorizontalAlignment="Center" />
                    <MediaElement x:Name="EventVideo" Grid.Row="2" LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop" Stretch="Uniform" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="PlayButton" Content="{DynamicResource EventPlay}" Click="PlayButton_OnClick"
                                IsEnabled="False" />
                        <Button x:Name="PauseButton" Content="{DynamicResource EventPause}" Click="PauseButton_OnClick"
                                IsEnabled="False" Margin="5,0,0,0" />
                        <Button x:Name="ExportButton" Content="{DynamicResource EventExport}" Click="ExportButton_OnClick"
                                IsEnabled="False" Margin="5,0,0,0" />
                        <Button x:Name="DeleteButton" Content="{DynamicResource EventDelete}" Click="DeleteButton_OnClick"
                                IsEnabled="False" Margin="5,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
