<Window x:Class="OpenCVCameraTracking.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:OpenCVCameraTracking.Localization"
        Title="{DynamicResource SettingsTitle}" Width="1160" Height="820"
        MinWidth="980" MinHeight="620"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="CanResizeWithGrip"
        Icon="Assets/AppIcon.ico">
    <Window.Resources>
        <localization:NotificationChannelKindConverter x:Key="NotificationChannelKindConverter" />
        <Style x:Key="ThemeOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,8,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ThemeCard" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="8">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeCard" Property="Background" Value="{DynamicResource ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ThemeCard" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThemeCard" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource StreamProfiles}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource StreamProfiles}" FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <ListBox x:Name="ProfilesBox" Grid.Row="1" DisplayMemberPath="Name"
                             SelectionChanged="ProfilesBox_OnSelectionChanged" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource ProfileName}" Margin="0,12,0,0" />
                    <TextBox x:Name="ProfileNameBox" Grid.Row="3" />
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{DynamicResource ProfileAddress}" />
                        <TextBox x:Name="ProfileAddressBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="5">
                        <TextBlock Text="{DynamicResource ProfileSubAddress}" />
                        <TextBox x:Name="ProfileSubAddressBox" />
                    </StackPanel>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ProfileGroup}" />
                            <TextBox x:Name="ProfileGroupBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource ProfileNotes}" />
                            <TextBox x:Name="ProfileNotesBox" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ProfileEnabledBox" Grid.Row="7" Content="{DynamicResource StreamEnabled}" />
                    <TextBlock Grid.Row="7" Text="{DynamicResource StreamEnabledHint}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" Margin="156,9,0,0" VerticalAlignment="Top" />
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{DynamicResource AddOrUpdate}" Click="AddOrUpdateButton_OnClick"
                                Background="{DynamicResource AccentFillBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="White" Margin="0,3,5,3" />
                        <Button Grid.Column="1" Content="{DynamicResource Delete}" Click="DeleteButton_OnClick"
                                Margin="5,3,0,3" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <TabControl x:Name="SettingsTabs">
                    <TabItem Header="{DynamicResource GeneralSettings}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Language}" Margin="0,4,0,0" />
                                <ComboBox x:Name="LanguageBox">
                                    <ComboBoxItem Content="{DynamicResource Chinese}" Tag="zh-CN" />
                                    <ComboBoxItem Content="{DynamicResource English}" Tag="en-US" />
                                </ComboBox>
                                 <TextBlock Text="{DynamicResource ThemeMode}" Margin="0,4,0,0" />
                                 <CheckBox x:Name="FollowSystemThemeBox" Content="{DynamicResource FollowSystemTheme}"
                                           Checked="ThemeModeControl_OnChanged" Unchecked="ThemeModeControl_OnChanged" />
                                 <TextBlock Text="{DynamicResource FollowSystemThemeHint}" Foreground="{DynamicResource MutedTextBrush}"
                                            TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" />
                                 <StackPanel x:Name="ThemeOptionsPanel" Orientation="Horizontal">
                                     <RadioButton x:Name="LightThemeRadioButton" GroupName="ThemeMode" Style="{StaticResource ThemeOptionStyle}"
                                                  Checked="ThemeModeControl_OnChanged" Width="150">
                                         <StackPanel>
                                             <Border Height="50" Background="#F6F8FA" BorderBrush="#D5DEE5" BorderThickness="1"
                                                     CornerRadius="4" Padding="9">
                                                 <StackPanel>
                                                     <Border Height="8" Width="82" HorizontalAlignment="Left" Background="#DCE5EB" CornerRadius="3" />
                                                     <Border Height="12" Width="56" HorizontalAlignment="Left" Background="#B8D5F8" CornerRadius="3" Margin="0,7,0,0" />
                                                 </StackPanel>
                                             </Border>
                                             <TextBlock Text="{DynamicResource ThemeLight}" FontWeight="SemiBold" Margin="2,7,2,0" />
                                             <TextBlock Text="{DynamicResource ThemeLightHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                        FontSize="11" TextWrapping="Wrap" Margin="2,2,2,0" />
                                         </StackPanel>
                                     </RadioButton>
                                     <RadioButton x:Name="DarkThemeRadioButton" GroupName="ThemeMode" Style="{StaticResource ThemeOptionStyle}"
                                                  Checked="ThemeModeControl_OnChanged" Width="150">
                                         <StackPanel>
                                             <Border Height="50" Background="#111418" BorderBrush="#263641" BorderThickness="1"
                                                     CornerRadius="4" Padding="9">
                                                 <StackPanel>
                                                     <Border Height="8" Width="82" HorizontalAlignment="Left" Background="#4B5A64" CornerRadius="3" />
                                                     <Border Height="12" Width="56" HorizontalAlignment="Left" Background="#2677C9" CornerRadius="3" Margin="0,7,0,0" />
                                                 </StackPanel>
                                             </Border>
                                             <TextBlock Text="{DynamicResource ThemeDark}" FontWeight="SemiBold" Margin="2,7,2,0" />
                                             <TextBlock Text="{DynamicResource ThemeDarkHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                        FontSize="11" TextWrapping="Wrap" Margin="2,2,2,0" />
                                         </StackPanel>
                                     </RadioButton>
                                 </StackPanel>
                                <TextBlock Text="{DynamicResource VideoBackend}" />
                                <ComboBox x:Name="BackendBox">
                                    <ComboBoxItem Content="{DynamicResource BackendAuto}" Tag="Auto" />
                                    <ComboBoxItem Content="DirectShow" Tag="DirectShow" />
                                    <ComboBoxItem Content="Media Foundation" Tag="MediaFoundation" />
                                    <ComboBoxItem Content="FFmpeg" Tag="Ffmpeg" />
                                </ComboBox>
                                <TextBlock Text="{DynamicResource PreviewLayout}" />
                                <ComboBox x:Name="LayoutBox">
                                    <ComboBoxItem Content="{DynamicResource LayoutSingle}" Tag="Single" />
                                    <ComboBoxItem Content="2 × 2" Tag="Grid2" />
                                    <ComboBoxItem Content="3 × 3" Tag="Grid3" />
                                    <ComboBoxItem Content="4 × 4" Tag="Grid4" />
                                </ComboBox>
                                <TextBlock Text="{DynamicResource DefaultStream}" />
                                <ComboBox x:Name="DefaultStreamBox" DisplayMemberPath="Name" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource AlertSettings}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{DynamicResource RestrictedZone}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource RestrictedZoneHint}" Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,14" />
                                <Border Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="12">
                                    <StackPanel>
                                        <TextBlock x:Name="RestrictedZoneSummaryText" Foreground="{DynamicResource WarningBrush}"
                                                   TextWrapping="Wrap" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="SetRestrictedZoneButton" Content="{DynamicResource SetRestrictedZone}"
                                                    Click="SetRestrictedZoneButton_OnClick" Margin="0,0,4,0" />
                                            <Button x:Name="ClearRestrictedZoneButton" Grid.Column="1" Content="{DynamicResource ClearRestrictedZone}"
                                                    Click="ClearRestrictedZoneButton_OnClick" Margin="4,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource NotificationSettings}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource NotificationSettingsHint}" Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,12" />
                                <ListBox Grid.Row="2" x:Name="NotificationChannelsBox" MinHeight="80" Margin="0,0,0,8"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MouseDoubleClick="NotificationChannelsBox_OnMouseDoubleClick"
                                         SelectionChanged="NotificationChannelsBox_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Kind, Converter={StaticResource NotificationChannelKindConverter}}"
                                                           Foreground="{DynamicResource AccentHighlightBrush}"
                                                           Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="3" x:Name="NotificationChannelsSummaryText" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12" Margin="0,0,0,8" />
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{DynamicResource AddNotification}" Click="AddNotificationButton_OnClick"
                                            Background="{DynamicResource AccentFillBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="White" Margin="0,0,4,0" />
                                    <Button Grid.Column="1" Content="{DynamicResource EditNotification}" Click="EditNotificationButton_OnClick"
                                            Margin="4,0" />
                                    <Button Grid.Column="2" Content="{DynamicResource DeleteNotification}" Click="DeleteNotificationButton_OnClick"
                                            Margin="4,0,0,0" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource RtspSettings}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource RtspSettings}" FontSize="18" FontWeight="SemiBold" />
                                <CheckBox x:Name="LowLatencyBox" Content="{DynamicResource LowLatencyMode}" Margin="0,12,0,3" />
                                <TextBlock Text="{DynamicResource LowLatencyHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="22,0,0,18" />
                                <Separator Margin="0,2,0,15" Background="{DynamicResource DividerBrush}" />
                                <TextBlock Text="{DynamicResource DetectionSettings}" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource FaceConfidence}" />
                                    <TextBlock x:Name="FaceConfidenceText" Grid.Column="1" Foreground="{DynamicResource AccentHighlightBrush}" />
                                </Grid>
                                <Slider x:Name="FaceConfidenceSlider" Minimum="0.3" Maximum="0.9" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_OnValueChanged" Margin="0,7,0,18" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource AnimalConfidence}" />
                                    <TextBlock x:Name="AnimalConfidenceText" Grid.Column="1" Foreground="{DynamicResource AccentHighlightBrush}" />
                                </Grid>
                                <Slider x:Name="AnimalConfidenceSlider" Minimum="0.15" Maximum="0.8" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_OnValueChanged" Margin="0,7,0,5" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource OnvifSettings}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource OnvifHint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource OnvifUser}" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource OnvifPassword}" Margin="8,0,0,0" />
                                    <TextBox x:Name="OnvifUserBox" Grid.Row="1" ToolTip="{DynamicResource OnvifUser}" />
                                    <PasswordBox x:Name="OnvifPasswordBox" Grid.Row="1" Grid.Column="1"
                                                 ToolTip="{DynamicResource OnvifPassword}"
                                                 Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                                 BorderThickness="1" Padding="10,6" Margin="8,5,0,12" />
                                </Grid>
                                <Button Content="{DynamicResource DiscoverOnvif}" Click="DiscoverOnvifButton_OnClick" />
                                <ListBox x:Name="OnvifDevicesBox" Height="150" DisplayMemberPath="DisplayName"
                                         SelectionChanged="OnvifDevicesBox_OnSelectionChanged" />
                                <Button Content="{DynamicResource ImportOnvifStream}" Click="ImportOnvifButton_OnClick" />
                                <TextBlock Text="{DynamicResource OnvifPtz}" Margin="0,14,0,2" />
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="←" Click="PtzLeftButton_OnClick" />
                                    <Button Grid.Column="1" Content="■" Click="PtzStopButton_OnClick" />
                                    <Button Grid.Column="2" Content="→" Click="PtzRightButton_OnClick" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="↑ / ↓" Click="PtzVerticalButton_OnClick" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PresetsBox" DisplayMemberPath="Name" />
                                    <Button Grid.Column="1" Content="{DynamicResource RefreshPresets}" Click="RefreshPresetsButton_OnClick" />
                                    <Button Grid.Column="2" Content="{DynamicResource GotoPreset}" Click="GotoPresetButton_OnClick" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource CameraProfiles}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource CameraProfilesHint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ListBox x:Name="CameraProfilesBox" Height="180" DisplayMemberPath="DisplayName"
                                         SelectionChanged="CameraProfilesBox_OnSelectionChanged" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CameraProfileGroupBox" ToolTip="{DynamicResource ProfileGroup}" />
                                    <TextBox x:Name="CameraProfileNotesBox" Grid.Column="1" Margin="8,5,0,12"
                                             ToolTip="{DynamicResource ProfileNotes}" />
                                </Grid>
                                <CheckBox x:Name="CameraProfileEnabledBox" Content="{DynamicResource CameraEnabled}" />
                                <Button Content="{DynamicResource SaveCameraProfile}" Click="SaveCameraProfileButton_OnClick" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Text="settings.json · LocalAppData" />
            <Button Grid.Column="1" Content="{DynamicResource Cancel}" Click="CancelButton_OnClick" MinWidth="100" />
            <Button Grid.Column="2" Content="{DynamicResource Save}" Click="SaveButton_OnClick"
                    Background="{DynamicResource AccentFillBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="White" MinWidth="110" />
        </Grid>
    </Grid>
</Window>
