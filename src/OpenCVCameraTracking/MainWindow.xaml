<Window x:Class="OpenCVCameraTracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Height="860" Width="1320"
        MinHeight="650" MinWidth="1020"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="12" Padding="14" CornerRadius="11"
                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" PanningMode="VerticalOnly">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource VideoSource}" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Settings}" Click="SettingsButton_OnClick"
                                Padding="11,7" Margin="6,0,0,0" />
                    </Grid>

                    <TextBlock Text="{DynamicResource SourceType}" />
                    <ComboBox x:Name="SourceKindBox" Margin="0,3,0,8"
                              SelectionChanged="SourceKindBox_OnSelectionChanged">
                        <ComboBoxItem Content="{DynamicResource LocalCamera}" Tag="Device" />
                        <ComboBoxItem Content="{DynamicResource NetworkStream}" Tag="Stream" />
                        <ComboBoxItem Content="{DynamicResource LocalFile}" Tag="File" />
                    </ComboBox>

                    <StackPanel x:Name="DevicePanel">
                        <TextBlock Text="{DynamicResource VideoDevice}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DeviceBox" Margin="0,3,6,8" DisplayMemberPath="Name" />
                            <Button Grid.Column="1" Content="{DynamicResource Refresh}"
                                    Click="RefreshDevicesButton_OnClick" Margin="0,2,0,7" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AddressPanel" Visibility="Collapsed">
                        <StackPanel x:Name="SavedStreamPanel">
                            <TextBlock Text="{DynamicResource SavedStream}" />
                            <ComboBox x:Name="StreamProfileBox" DisplayMemberPath="Name"
                                      SelectionChanged="StreamProfileBox_OnSelectionChanged" />
                            <TextBlock Text="{DynamicResource StreamVariant}" />
                            <ComboBox x:Name="StreamVariantBox" SelectionChanged="StreamVariantBox_OnSelectionChanged">
                                <ComboBoxItem Content="{DynamicResource MainStream}" Tag="Main" />
                                <ComboBoxItem Content="{DynamicResource SubStream}" Tag="Sub" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource AddressOrFile}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddressBox" LostFocus="AddressBox_OnLostFocus" />
                            <Button x:Name="BrowseVideoButton" Grid.Column="1" Content="{DynamicResource Browse}"
                                    Click="BrowseVideoButton_OnClick" Visibility="Collapsed" Margin="6,4,0,11" />
                        </Grid>
                    </StackPanel>

                    <Separator Margin="0,3,0,11" Background="{DynamicResource DividerBrush}" />
                    <TextBlock Text="{DynamicResource DetectionTracking}" FontSize="22" FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource DetectionMode}" />
                    <ComboBox x:Name="DetectionModeBox" Margin="0,3,0,8"
                              SelectionChanged="DetectionModeBox_OnSelectionChanged">
                        <ComboBoxItem Content="{DynamicResource FaceYuNet}" Tag="Face" />
                        <ComboBoxItem Content="{DynamicResource FaceHaar}" Tag="Haar" />
                        <ComboBoxItem Content="{DynamicResource AnimalYolo}" Tag="Animal" />
                        <ComboBoxItem Content="{DynamicResource PersonAnimalMode}" Tag="PersonAnimal" />
                    </ComboBox>

                    <StackPanel x:Name="ModelPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource AnimalModel}" />
                        <ComboBox x:Name="AnimalModelBox" SelectionChanged="AnimalModelBox_OnSelectionChanged">
                            <ComboBoxItem Content="{DynamicResource BuiltInYoloX}" Tag="BuiltIn" />
                            <ComboBoxItem Content="{DynamicResource CustomYolo}" Tag="Custom" />
                        </ComboBox>
                        <StackPanel x:Name="CustomModelPanel" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource CustomModelPath}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ModelPathBox" />
                                <Button Grid.Column="1" Content="{DynamicResource Browse}"
                                        Click="BrowseModelButton_OnClick" Margin="6,4,0,11" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource ModelHint}" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>

                    <Separator Margin="0,3,0,11" Background="{DynamicResource DividerBrush}" />
                    <TextBlock Text="{DynamicResource RecognitionWhitelist}" FontSize="19"
                               FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Button Content="{DynamicResource ManageWhitelist}" Click="WhitelistButton_OnClick"
                            HorizontalAlignment="Stretch" Margin="0,1,0,4" />
                    <TextBlock x:Name="WhitelistSummaryText" Foreground="{DynamicResource AccentHighlightBrush}" Margin="2,0,0,6" />
                    <TextBlock Text="{DynamicResource RecognitionLog}" Margin="0,0,0,3" />
                    <ListBox x:Name="RecognitionLogBox" Height="92" Margin="0,0,0,8">
                        <ListBoxItem Content="{DynamicResource NoRecognitionEvents}" IsHitTestVisible="False"
                                     Foreground="{DynamicResource SubtleTextBrush}" />
                    </ListBox>

                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartButton" Content="{DynamicResource Start}" Click="StartButton_OnClick"
                                Background="{DynamicResource AccentFillBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
                        <Button x:Name="StopButton" Grid.Column="1" Content="{DynamicResource Stop}"
                                Click="StopButton_OnClick" IsEnabled="False" />
                    </Grid>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{DynamicResource Diagnose}" Click="DiagnoseButton_OnClick" />
                        <Button Grid.Column="1" Content="{DynamicResource MultiCamera}" Click="MultiCameraButton_OnClick" />
                        <Button Grid.Column="2" Content="{DynamicResource Reconnect}" Click="ReconnectButton_OnClick" />
                    </Grid>

                    <Border Margin="0,6,0,0" Padding="10" CornerRadius="7" Background="{DynamicResource SurfaceSubtleBrush}">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Text="{DynamicResource Ready}" TextWrapping="Wrap" />
                            <TextBlock x:Name="MetricsText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Margin="0,14,14,14" CornerRadius="11"
                Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="PreviewPlaceholder" Text="{DynamicResource WaitingPreview}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource PlaceholderTextBrush}" FontSize="24" />
                <Border x:Name="UpdateBanner" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                        Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource UpdateAvailable}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="&#x00D7;" ToolTip="{DynamicResource Close}"
                                    Click="DismissUpdateButton_OnClick" Padding="7,1" Margin="10,-2,-5,-2"
                                    FontSize="16" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock x:Name="UpdateVersionText" Foreground="{DynamicResource AccentHighlightBrush}" Margin="0,3,0,8" />
                        <Button Content="{DynamicResource OpenStore}" Click="OpenStoreButton_OnClick"
                                HorizontalAlignment="Right" Padding="10,5" />
                    </StackPanel>
                </Border>
                <Border x:Name="UnknownAlertBanner" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20"
                        Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="22,11">
                    <TextBlock x:Name="UnknownAlertText" Foreground="White" FontSize="20"
                               FontWeight="Bold" />
                </Border>
                <Border x:Name="RestrictedZoneAlertBanner" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,78,20,0"
                        Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerMutedBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="22,11">
                    <TextBlock x:Name="RestrictedZoneAlertText" Foreground="White" FontSize="20"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
